# Discord bot token (Bot application, not a user token). The bot needs
# the Manage Channels and Move Members permissions in your server.
DISCORD_BOT_TOKEN=

# Join-to-create hub voice channel ID (right-click the channel with
# Developer Mode enabled -> Copy Channel ID). Members who join this channel
# get their own temporary voice channel. Leave blank to disable the temp
# voice channel feature.
VOICE_HUB_CHANNEL_ID=

# Optional: category ID that temp channels are created under. Leave blank
# to use the hub channel's own category.
VOICE_HUB_CATEGORY_ID=

# Path to juno's embedded SQLite database, used to persist temp voice
# channel state across restarts. The docker-compose setup mounts a volume
# at /app/data, so the default below is usually fine as-is.
DB_PATH=./data/juno.db
