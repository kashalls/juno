# Port the HTTP server listens on inside the container.
PORT=8080

# Discord bot token (Bot application, not a user token). Needs the
# "Presence Intent" and "Server Members Intent" privileged intents enabled
# in the Discord Developer Portal, and must be invited to a server you're
# also in.
DISCORD_BOT_TOKEN=

# Your Discord user ID (right-click your name in Discord with Developer
# Mode enabled -> Copy User ID). This is the only user this API will ever
# report presence for.
DISCORD_USER_ID=

# Optional: restrict presence lookups to one specific shared guild ID. Leave
# blank to use whichever shared guild the bot sees the user in first.
DISCORD_GUILD_ID=

# Comma-separated list of CIDRs for reverse proxies you trust to set
# X-Forwarded-For (e.g. your ingress/LB's pod or VPC ranges). The client IP
# used for logging is read from the right-most X-Forwarded-For entry that
# isn't inside one of these ranges. Leave blank if the service is reachable
# directly (no reverse proxy in front) - the TCP connection's source IP is
# used instead, and X-Forwarded-For is ignored to prevent spoofing.
TRUSTED_PROXY_CIDRS=

# Path to juno's embedded SQLite database, used to persist per-guild
# join-to-create voice hub settings and temp channel state across restarts.
# The docker-compose setup mounts a volume at /app/data, so the default
# below is usually fine as-is.
DB_PATH=./data/juno.db
